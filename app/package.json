{
  "name": "callapicall-voice",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Client vocale Android per callAPIcall (Handy + Hermes) \u2014 equivalente di Shift+F1 da remoto.",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/copy-ort.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "cap:sync": "cap sync android",
    "cap:open": "cap open android",
    "android": "npm run build && cap sync android && cap open android",
    "build:web": "node scripts/copy-ort.mjs && vite build --base=./ --outDir dist-web",
    "copy:ort": "node scripts/copy-ort.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/camera": "^6",
    "@capacitor/core": "^6.1.2",
    "@capacitor/filesystem": "^6",
    "@capacitor/haptics": "^6.0.2",
    "@capacitor/keyboard": "^6.0.3",
    "@capacitor/local-notifications": "^6.1.0",
    "@capacitor/preferences": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2",
    "@tanstack/react-query": "^5.59.0",
    "clsx": "^2.1.1",
    "i18next": "^23.15.1",
    "lightweight-charts": "^4.2.1",
    "lucide-react": "^0.451.0",
    "onnxruntime-web": "^1.20.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.0.2",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.2",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
